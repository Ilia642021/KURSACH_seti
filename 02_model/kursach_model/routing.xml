<config>
    <!-- HQ Nodes -->
    <interface hosts="core" names="eth0" address="10.0.0.1" netmask="255.255.255.0"/>
    <interface hosts="hqSrv[0]" names="eth0" address="10.0.0.10" netmask="255.255.255.0"/>
    <interface hosts="hqSrv[1]" names="eth0" address="10.0.0.11" netmask="255.255.255.0"/>
    
    <!-- All HQ PCs and Extra hosts in the same /24 subnet -->
    <interface hosts="admin*[*] acc*[*] dir*[*] war*[*] kit*[*] hall*[*]" names="eth0" address="10.0.0.x" netmask="255.255.255.0"/>

    <!-- Branches -->
    <interface hosts="br1R" names="eth0" address="10.0.70.1" netmask="255.255.255.0"/>
    <interface hosts="br1Host[*]" names="eth0" address="10.0.70.x" netmask="255.255.255.0"/>

    <interface hosts="br2R" names="eth0" address="10.0.80.1" netmask="255.255.255.0"/>
    <interface hosts="br2Host[*]" names="eth0" address="10.0.80.x" netmask="255.255.255.0"/>

    <!-- ISP and External Resource -->
    <interface hosts="externalResource" names="eth0" address="10.0.90.10" netmask="255.255.255.0"/>
    <interface hosts="isp" names="eth0" address="10.0.90.1" netmask="255.255.255.0"/>

    <!-- WAN PPP links -->
    <interface hosts="core" names="ppp0" address="10.0.101.1" netmask="255.255.255.252"/>
    <interface hosts="br1R" names="ppp0" address="10.0.101.2" netmask="255.255.255.252"/>

    <interface hosts="core" names="ppp1" address="10.0.102.1" netmask="255.255.255.252"/>
    <interface hosts="br2R" names="ppp0" address="10.0.102.2" netmask="255.255.255.252"/>

    <interface hosts="core" names="ppp2" address="10.0.103.1" netmask="255.255.255.252"/>
    <interface hosts="isp" names="ppp0" address="10.0.103.2" netmask="255.255.255.252"/>

    <interface hosts="core" names="ppp3" address="10.0.104.1" netmask="255.255.255.252"/>
    <interface hosts="isp" names="ppp1" address="10.0.104.2" netmask="255.255.255.252"/>

    <!-- Default Gateways for Hosts -->
    <route hosts="admin*[*] acc*[*] dir*[*] war*[*] kit*[*] hall*[*] hqSrv[*]" destination="0.0.0.0" netmask="0.0.0.0" gateway="10.0.0.1" interface="eth0"/>
    <route hosts="br1Host[*]" destination="0.0.0.0" netmask="0.0.0.0" gateway="10.0.70.1" interface="eth0"/>
    <route hosts="br2Host[*]" destination="0.0.0.0" netmask="0.0.0.0" gateway="10.0.80.1" interface="eth0"/>
    <route hosts="externalResource" destination="0.0.0.0" netmask="0.0.0.0" gateway="10.0.90.1" interface="eth0"/>

    <!-- Failover Routes for Core Router (Internet Access) -->
    <route hosts="core" destination="10.0.90.0" netmask="255.255.255.0" gateway="10.0.103.2" interface="ppp2" metric="10"/>
    <route hosts="core" destination="10.0.90.0" netmask="255.255.255.0" gateway="10.0.104.2" interface="ppp3" metric="50"/>

    <!-- Failover Routes for ISP Router (Return path to HQ) -->
    <route hosts="isp" destination="10.0.0.0" netmask="255.255.255.0" gateway="10.0.103.1" interface="ppp0" metric="10"/>
    <route hosts="isp" destination="10.0.0.0" netmask="255.255.255.0" gateway="10.0.104.1" interface="ppp1" metric="50"/>

    <!-- Core Router Internal Route -->
    <route hosts="core" destination="10.0.0.0" netmask="255.255.255.0" interface="eth0"/>
    
    <!-- Branch Routes back to HQ -->
    <route hosts="br1R" destination="10.0.0.0" netmask="255.255.255.0" gateway="10.0.101.1" interface="ppp0"/>
    <route hosts="br2R" destination="10.0.0.0" netmask="255.255.255.0" gateway="10.0.102.1" interface="ppp0"/>
</config>
