<?xml version="1.0" encoding="UTF-8"?>
<OSPFASConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="OSPFASConfig.xsd">
  
  <!-- Ядро сети HQ -->
  <Router name="core" RFC1583Compatible="true">
    <PointToPointInterface ifName="ppp0" areaID="0.0.0.0" interfaceOutputCost="5" />
    <PointToPointInterface ifName="ppp1" areaID="0.0.0.0" interfaceOutputCost="5" />
    <PointToPointInterface ifName="ppp2" areaID="0.0.0.0" interfaceOutputCost="10" />
    <PointToPointInterface ifName="ppp3" areaID="0.0.0.0" interfaceOutputCost="50" />
    <BroadcastInterface ifName="eth0" areaID="0.0.0.0" interfaceOutputCost="1" />
  </Router>

  <!-- Маршрутизатор Филиала 1 -->
  <Router name="br1R" RFC1583Compatible="true">
    <PointToPointInterface ifName="ppp0" areaID="0.0.0.0" interfaceOutputCost="5" />
    <BroadcastInterface ifName="eth0" areaID="0.0.0.0" interfaceOutputCost="1" />
  </Router>

  <!-- Маршрутизатор Филиала 2 -->
  <Router name="br2R" RFC1583Compatible="true">
    <PointToPointInterface ifName="ppp0" areaID="0.0.0.0" interfaceOutputCost="5" />
    <BroadcastInterface ifName="eth0" areaID="0.0.0.0" interfaceOutputCost="1" />
  </Router>

  <!-- Маршрутизатор Провайдера (ISP) -->
  <Router name="isp" RFC1583Compatible="true">
    <PointToPointInterface ifName="ppp0" areaID="0.0.0.0" interfaceOutputCost="10" />
    <PointToPointInterface ifName="ppp1" areaID="0.0.0.0" interfaceOutputCost="50" />
    <BroadcastInterface ifName="eth0" areaID="0.0.0.0" interfaceOutputCost="1" />
  </Router>

</OSPFASConfig>
